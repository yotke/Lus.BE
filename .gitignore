################################################################################
# .gitignore for Luz (.NET 9 backend + Angular frontend)
################################################################################

## ---------------------------------------------------------------------------
## .NET / Visual Studio / Rider
## ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Oo]ut/
[Pp]ublish/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# Rider / JetBrains
.idea/
*.iml

# Test results / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# ASP.NET / EF
*.mdf
*.ldf
*.ndf
appsettings.*.local.json

## ---------------------------------------------------------------------------
## Node / Angular (Lus.UI)
## ---------------------------------------------------------------------------
node_modules/
.angular/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Angular test/e2e artifacts
/coverage
/playwright-report
/test-results

## ---------------------------------------------------------------------------
## OS / Editor
## ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

## ---------------------------------------------------------------------------
## Frontend lives in its own repo (yotke/Lus.FE). It is a nested git repo at
## src/Lus.UI and is intentionally NOT tracked by the backend (yotke/Lus.BE) repo.
## ---------------------------------------------------------------------------
/src/Lus.UI/

## ---------------------------------------------------------------------------
## Secrets / local config
## ---------------------------------------------------------------------------
*.pfx
*.key
secrets.json
.env
.env.local
