<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release;TestingServer</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!-- JwtBearer is NOT part of the Microsoft.AspNetCore.App shared framework; it must be
             referenced explicitly. It also brings System.IdentityModel.Tokens.Jwt transitively. -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
        <PackageReference Include="EasyCaching.Core" Version="1.9.0" />
        <PackageReference Include="IdentityModel" Version="6.1.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lus.Contracts\Lus.Contracts.csproj" />
    </ItemGroup>

</Project>
